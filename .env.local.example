# Optional: turn on live AI answers for the doubt chat (via OpenRouter).
# Without this, the app runs fully offline with a content-grounded answer engine.
# Copy this file to .env.local and paste your key to enable live chat.
OPENROUTER_API_KEY=

# Optional: override the model (defaults to openai/gpt-5.6-terra).
# OPENROUTER_MODEL=openai/gpt-5.6-terra
